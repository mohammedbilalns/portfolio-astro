---
interface EducationItem {
  degree: string;
  institution: string;
  duration: string;
}

interface Props {
  education: {
    title: string;
    items: EducationItem[];
  };
}

const { education } = Astro.props;
---

<section class="section" id="about">
  <header class="section-head reveal">
    <p class="section-kicker">Academic Background</p>
    <h2 class="section-heading-title">Education &amp; <em>Foundation</em></h2>
  </header>

  <div class="education-editorial reveal" style="--reveal-delay: 80ms;">
    {education.items.map((item, index) => (
      <article class="edu-plate">
        <div class="edu-time">
          <span class="edu-period">{item.duration}</span>
        </div>
        <div class="edu-info">
          <h3 class="edu-degree">{item.degree}</h3>
          <span class="edu-school">{item.institution}</span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .education-editorial {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hairline);
  }

  .edu-plate {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .edu-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .edu-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .edu-degree {
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .edu-school {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-style: italic;
    color: var(--ink-soft);
    word-break: break-word;
  }

  @media (max-width: 768px) {
    .edu-plate {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1.5rem 0;
    }
  }
</style>
