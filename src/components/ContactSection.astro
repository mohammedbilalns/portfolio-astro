---
import SectionHeading from "./SectionHeading.astro";

interface ContactField {
  name: string;
  label: string;
  placeholder: string;
  required: boolean;
}

interface Props {
  contact: {
    title: string;
    subtitle: string;
    description: string;
    details: {
      email: string;
      phone: string;
      github: string;
      linkedin: string;
      leetcode: string;
      location: string;
      availability: string;
    };
    form: {
      title: string;
      fields: ContactField[];
      submitText: string;
    };
  };
}

const { contact } = Astro.props;
const web3FormsAccessKey = "dfbd05c7-6865-4b6b-b1b0-4be1a604019d";

const detailEntries = [
  ["Email", contact.details.email],
  ["Phone", contact.details.phone],
  ["Location", contact.details.location],
  ["Availability", contact.details.availability],
];

const linkEntries = [
  ["GitHub", contact.details.github],
  ["LinkedIn", contact.details.linkedin],
  ["LeetCode", contact.details.leetcode],
];
---

<section class="section" id="contact">
  <div class="reveal reveal--up">
    <SectionHeading icon="sparkles" title={contact.title} subtitle={contact.subtitle} />
  </div>

  <div class="contact-grid">
    <article class="panel contact-card reveal reveal--up" style="--reveal-delay: 120ms;">
      <p class="contact-card__description">{contact.description}</p>

      <div class="contact-card__facts">
        {detailEntries.map(([label, value]) => (
          <div class="contact-card__fact">
            <span>{label}</span>
            {label === "Email" ? (
              <div class="contact-card__email-row">
                <strong>{value}</strong>
                <button
                  type="button"
                  class="copy-email-btn"
                  data-email={value}
                  aria-label="Copy email address"
                  title="Copy email address"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="14" height="14" x="8" y="8" rx="2" />
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                  </svg>
                  <span class="copy-email-btn__text">Copy</span>
                </button>
              </div>
            ) : (
              <strong>{value}</strong>
            )}
          </div>
        ))}
      </div>

      <div class="contact-card__links">
        {linkEntries.map(([label, href]) => (
          <a href={href} target="_blank" rel="noreferrer">{label}</a>
        ))}
      </div>
    </article>

    <article class="panel form-card reveal reveal--up" style="--reveal-delay: 200ms;">
      <h3>{contact.form.title}</h3>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="contact-form"
      >
        <input type="hidden" name="access_key" value={web3FormsAccessKey} />

        {contact.form.fields.map((field) =>
          field.name === "message" ? (
            <label>
              <span>{field.label}</span>
              <textarea
                name={field.name}
                placeholder={field.placeholder}
                required={field.required}
                rows={6}
              ></textarea>
            </label>
          ) : (
            <label>
              <span>{field.label}</span>
              <input
                type={field.name === "email" ? "email" : "text"}
                name={field.name === "fullName" ? "name" : field.name}
                placeholder={field.placeholder}
                required={field.required}
              />
            </label>
          )
        )}

        <button type="submit">{contact.form.submitText}</button>
      </form>
    </article>
  </div>
</section>

<script>
  const copyButtons = document.querySelectorAll(".copy-email-btn");

  const copyWithFallback = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement("textarea");
      area.value = text;
      area.setAttribute("readonly", "");
      area.style.position = "absolute";
      area.style.left = "-9999px";
      document.body.appendChild(area);
      area.select();
      let ok = false;
      try {
        ok = document.execCommand("copy");
      } catch {
        ok = false;
      }
      document.body.removeChild(area);
      return ok;
    }
  };

  copyButtons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    const label = button.querySelector(".copy-email-btn__text");
    let timer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", async () => {
      const email = button.dataset.email ?? "";
      if (!email) return;
      const ok = await copyWithFallback(email);
      if (label) label.textContent = ok ? "Copied!" : "Failed";
      button.classList.toggle("is-copied", ok);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = "Copy";
        button.classList.remove("is-copied");
      }, 2000);
    });
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.95fr);
    gap: 1.5rem;
  }

  .contact-card,
  .form-card {
    padding: 1.6rem;
  }

  .contact-card__description {
    margin: 0 0 1.25rem;
    color: #d3dce8;
    line-height: 1.8;
  }

  .contact-card__facts {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }

  .contact-card__facts > div {
    display: grid;
    gap: 0.18rem;
    padding: 0.95rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
  }

  .contact-card__facts span {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .contact-card__fact strong {
    overflow-wrap: anywhere;
  }

  .contact-card__email-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .copy-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(96, 165, 250, 0.3);
    background: rgba(96, 165, 250, 0.08);
    color: #cfe2ff;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .copy-email-btn:hover {
    border-color: rgba(96, 165, 250, 0.6);
    background: rgba(96, 165, 250, 0.15);
    color: #ffffff;
  }

  .copy-email-btn.is-copied {
    border-color: rgba(74, 222, 128, 0.5);
    background: rgba(74, 222, 128, 0.1);
    color: #86efac;
  }

  .copy-email-btn svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .contact-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .contact-card__links a {
    padding: 0.6rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(96, 165, 250, 0.25);
    color: #cfe2ff;
  }

  .form-card h3 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .contact-form label {
    display: grid;
    gap: 0.45rem;
  }

  .contact-form span {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    padding: 0.9rem 1rem;
    font: inherit;
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form button {
    min-height: 3rem;
    border: 0;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.85), rgba(29, 78, 216, 0.72));
    color: white;
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
