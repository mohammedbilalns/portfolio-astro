---
import SectionHeading from "./SectionHeading.astro";

interface ContactField {
  name: string;
  label: string;
  placeholder: string;
  required: boolean;
}

interface Props {
  contact: {
    title: string;
    subtitle: string;
    description: string;
    details: {
      email: string;
      phone: string;
      github: string;
      linkedin: string;
      leetcode: string;
      location: string;
      availability: string;
    };
    form: {
      title: string;
      fields: ContactField[];
      submitText: string;
    };
  };
}

const { contact } = Astro.props;
const web3FormsAccessKey = "dfbd05c7-6865-4b6b-b1b0-4be1a604019d";

const detailEntries = [
  ["Email", contact.details.email],
  ["Phone", contact.details.phone],
  ["Location", contact.details.location],
  ["Availability", contact.details.availability],
];

const linkEntries = [
  ["GitHub", contact.details.github],
  ["LinkedIn", contact.details.linkedin],
  ["LeetCode", contact.details.leetcode],
];
---

<section class="section" id="contact">
  <div class="reveal reveal--up">
    <SectionHeading icon="sparkles" title={contact.title} subtitle={contact.subtitle} />
  </div>

  <div class="contact-grid">
    <article class="panel contact-card reveal reveal--up" style="--reveal-delay: 120ms;">
      <p class="contact-card__description">{contact.description}</p>

      <div class="contact-card__facts">
        {detailEntries.map(([label, value]) => (
          <div>
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>

      <div class="contact-card__links">
        {linkEntries.map(([label, href]) => (
          <a href={href} target="_blank" rel="noreferrer">{label}</a>
        ))}
      </div>
    </article>

    <article class="panel form-card reveal reveal--up" style="--reveal-delay: 200ms;">
      <h3>{contact.form.title}</h3>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="contact-form"
      >
        <input type="hidden" name="access_key" value={web3FormsAccessKey} />

        {contact.form.fields.map((field) =>
          field.name === "message" ? (
            <label>
              <span>{field.label}</span>
              <textarea
                name={field.name}
                placeholder={field.placeholder}
                required={field.required}
                rows={6}
              ></textarea>
            </label>
          ) : (
            <label>
              <span>{field.label}</span>
              <input
                type={field.name === "email" ? "email" : "text"}
                name={field.name === "fullName" ? "name" : field.name}
                placeholder={field.placeholder}
                required={field.required}
              />
            </label>
          )
        )}

        <button type="submit">{contact.form.submitText}</button>
      </form>
    </article>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.95fr);
    gap: 1.5rem;
  }

  .contact-card,
  .form-card {
    padding: 1.6rem;
  }

  .contact-card__description {
    margin: 0 0 1.25rem;
    color: #d3dce8;
    line-height: 1.8;
  }

  .contact-card__facts {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }

  .contact-card__facts div {
    display: grid;
    gap: 0.18rem;
    padding: 0.95rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
  }

  .contact-card__facts span {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .contact-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .contact-card__links a {
    padding: 0.6rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(96, 165, 250, 0.25);
    color: #cfe2ff;
  }

  .form-card h3 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
  }

  .contact-form label {
    display: grid;
    gap: 0.45rem;
  }

  .contact-form span {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    padding: 0.9rem 1rem;
    font: inherit;
  }

  .contact-form textarea {
    resize: vertical;
  }

  .contact-form button {
    min-height: 3rem;
    border: 0;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.85), rgba(29, 78, 216, 0.72));
    color: white;
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
