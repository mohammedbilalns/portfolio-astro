---
import { Icon as AstroIcon } from "astro-icon/components";

interface ContactField {
  name: string;
  label: string;
  placeholder: string;
  required: boolean;
}

interface Props {
  contact: {
    title: string;
    subtitle: string;
    description: string;
    details: {
      email: string;
      phone: string;
      github: string;
      linkedin: string;
      leetcode: string;
      location: string;
      availability: string;
    };
    form: {
      title: string;
      fields: ContactField[];
      submitText: string;
    };
  };
}

const { contact } = Astro.props;
const web3FormsAccessKey = "dfbd05c7-6865-4b6b-b1b0-4be1a604019d";

const channels = [
  {
    title: "Direct Email",
    value: contact.details.email,
    href: `mailto:${contact.details.email}`,
    isEmail: true
  },
  {
    title: "LinkedIn",
    value: "in/mohammed-bilal-ns",
    href: contact.details.linkedin
  },
  {
    title: "GitHub",
    value: "github.com/mohammedbilalns",
    href: contact.details.github
  },
  {
    title: "LeetCode",
    value: "leetcode.com/u/mohammedbilalns",
    href: contact.details.leetcode
  }
];
---

<section class="section" id="contact">
  <div class="contact-editorial">
    <!-- Left: Narrative & Channels -->
    <div class="contact-narrative reveal">
      <p class="section-kicker">Get In Touch</p>
      <h2 class="contact-title">
        Have a project or opportunity? <em>Let’s talk.</em>
      </h2>
      <p class="contact-desc">
        {contact.description}
      </p>
      <p class="contact-subnote">
        Based in {contact.details.location} · Open to opportunities worldwide.
      </p>

      <!-- Channel Rows -->
      <div class="channels-stack">
        {channels.map((ch) => (
          <a
            href={ch.href}
            target={ch.isEmail ? undefined : "_blank"}
            rel={ch.isEmail ? undefined : "noreferrer"}
            class="channel-item"
          >
            <div class="channel-text">
              <span class="channel-label">{ch.title}</span>
              <span class="channel-val">{ch.value}</span>
            </div>
            <span class="channel-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Right: Substantial Enlarged Contact Form -->
    <div class="contact-form-side reveal" style="--reveal-delay: 100ms;">
      <div class="form-wrapper">
        <h3 class="form-heading">Send a Message</h3>
        <p class="form-subnote">Drop a brief note below and I will get back to you directly.</p>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="editorial-form"
          id="editorial-contact-form"
        >
          <input type="hidden" name="access_key" value={web3FormsAccessKey} />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <label class="field-group">
            <span class="field-label">Name</span>
            <input type="text" name="name" placeholder="Your name" required class="form-input" />
          </label>

          <label class="field-group">
            <span class="field-label">Email</span>
            <input type="email" name="email" placeholder="your.email@example.com" required class="form-input" />
          </label>

          <label class="field-group">
            <span class="field-label">Message</span>
            <textarea name="message" placeholder="Share what you have in mind or just say hello..." rows={5} required class="form-input form-textarea"></textarea>
          </label>

          <button type="submit" class="btn btn--accent form-submit-btn">
            <span>Send Message</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </button>

          <div id="contact-status-feedback" class="status-feedback"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('editorial-contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-status-feedback');

  if (form && statusEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Transmitting...';
      }

      statusEl.className = 'status-feedback';
      statusEl.textContent = '';

      try {
        const formData = new FormData(form);
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });
        const data = await res.json();

        if (data.success) {
          statusEl.className = 'status-feedback is-success';
          statusEl.textContent = '✓ Message received. I will be in touch shortly.';
          form.reset();
        } else {
          statusEl.className = 'status-feedback is-error';
          statusEl.textContent = data.message || 'Error transmitting message.';
        }
      } catch (err) {
        statusEl.className = 'status-feedback is-error';
        statusEl.textContent = 'Failed to transmit message. Please email directly.';
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Send Message</span> <span class="btn-arrow" aria-hidden="true">→</span>`;
        }
      }
    });
  }
</script>

<style>
  .contact-editorial {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.45fr);
    gap: 3.5rem;
    align-items: start;
    padding-top: 1rem;
  }

  .contact-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-title {
    font-family: var(--display);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .contact-title em {
    font-style: italic;
    font-family: var(--display);
    color: var(--accent);
  }

  .contact-desc {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .contact-subnote {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }

  .channels-stack {
    display: flex;
    flex-direction: column;
    margin-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .channel-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--hairline);
    transition: transform 160ms ease;
  }

  .channel-item:hover {
    transform: translateX(4px);
  }

  .channel-item:hover .channel-val {
    color: var(--accent);
  }

  .channel-item:hover .channel-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .channel-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .channel-val {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
    transition: color 160ms ease;
  }

  .channel-arrow {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--ink-faint);
    transition: all 160ms ease;
  }

  /* Form Side - Enlarged & Generous */
  .contact-form-side {
    width: 100%;
  }

  .form-wrapper {
    background: var(--paper-surface);
    border: 1px solid var(--hairline-accent);
    border-radius: var(--radius-lg);
    padding: 3rem 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
  }

  html[data-theme="light"] .form-wrapper {
    box-shadow: 0 16px 36px rgba(26, 28, 34, 0.06);
  }

  .form-heading {
    font-family: var(--display);
    font-size: clamp(2rem, 3.5vw, 2.4rem);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .form-subnote {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-style: italic;
    color: var(--ink-soft);
    margin-top: -0.65rem;
  }

  .editorial-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .form-input {
    width: 100%;
    padding: 0.95rem 1.15rem;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 0.9375rem;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  html[data-theme="light"] .form-input {
    background: #ede8dc;
    border-color: rgba(26, 28, 34, 0.12);
  }

  .form-input:focus {
    border-color: var(--accent);
    outline: none;
  }

  html[data-theme="light"] .form-input:focus {
    background: #f7f4ed;
  }

  .form-input::placeholder {
    color: var(--ink-faint);
  }

  .form-textarea {
    resize: vertical;
    min-height: 160px;
    line-height: 1.6;
  }

  .form-submit-btn {
    align-self: flex-start;
    padding: 0.9rem 2rem;
  }

  .status-feedback {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .status-feedback.is-success {
    color: var(--accent-emerald);
  }

  .status-feedback.is-error {
    color: var(--accent-rose);
  }

  @media (max-width: 900px) {
    .contact-editorial {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .form-wrapper {
      padding: 2.25rem 1.75rem;
    }
  }

  @media (max-width: 600px) {
    .field-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
