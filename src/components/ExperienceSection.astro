---
import SectionHeading from "./SectionHeading.astro";

interface ExperienceItem {
  position: string;
  company: string;
  duration: string;
  responsibilities: string[];
}

interface Props {
  experience: {
    title: string;
    items: ExperienceItem[];
  };
}

const { experience } = Astro.props;
---

<section class="section" id="experience">
  <SectionHeading icon="02" title={experience.title} />

  <div class="experience-list">
    {experience.items.map((item) => (
      <article class="experience-card">
        <div class="experience-card__top">
          <div>
            <h3>{item.company}</h3>
            <p>{item.position}</p>
          </div>
          <span>{item.duration}</span>
        </div>

        <ul>
          {item.responsibilities.map((entry) => (
            <li>{entry}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .experience-list {
    display: grid;
    gap: 1.5rem;
  }

  .experience-card {
    padding: 1.6rem 1.7rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(19, 19, 19, 0.95), rgba(11, 11, 11, 0.88));
  }

  .experience-card__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .experience-card__top h3,
  .experience-card__top p,
  .experience-card__top span {
    margin: 0;
  }

  .experience-card__top h3 {
    font-size: 1.5rem;
  }

  .experience-card__top p {
    margin-top: 0.35rem;
    color: #8ebeff;
  }

  .experience-card__top span {
    color: var(--text-muted);
    white-space: nowrap;
  }

  .experience-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  .experience-card li {
    position: relative;
    padding-left: 1.3rem;
    color: #d0d8e3;
    line-height: 1.7;
  }

  .experience-card li::before {
    content: "";
    position: absolute;
    top: 0.72rem;
    left: 0;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: #38bdf8;
  }

  @media (max-width: 720px) {
    .experience-card__top {
      flex-direction: column;
    }

    .experience-card__top span {
      white-space: normal;
    }
  }
</style>
