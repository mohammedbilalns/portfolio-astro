---
interface Props {
  logo: string;
  name: string;
}

const { logo, name } = Astro.props;
---

<header class="site-header reveal reveal--down">
  <div class="site-header__inner">
    <a class="brand" href="#home" aria-label={`${name} home`}>
      <span class="brand__mark">{logo}</span>
      <span class="brand__name">{name.toLowerCase().replace(/\s+/g, "")}</span>
    </a>
  </div>
</header>
