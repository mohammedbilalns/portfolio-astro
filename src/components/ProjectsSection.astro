---
import { Icon as AstroIcon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface ProjectItem {
  id: string;
  name: string;
  category: string;
  description: string;
  technologies: string[];
  liveDemo?: string;
  sourceCode: string;
  image?: string;
}

interface Props {
  projects: {
    title: string;
    subtitle: string;
    items: ProjectItem[];
  };
}

const { projects } = Astro.props;

const projectImages = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp,avif,gif,svg,tiff}', { eager: true });

const resolveProjectImage = (image?: string) => {
  if (!image) return null;
  const key = `../assets/projects/${image}`;
  return projectImages[key]?.default ?? null;
};

const romanNumerals = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX"];
---

<section class="section" id="projects">
  <header class="section-head reveal">
    <p class="section-kicker">Exhibition of Work</p>
    <h2 class="section-heading-title">Selected <em>Works &amp; Systems</em></h2>
    <p class="section-subtitle">{projects.subtitle}</p>
  </header>

  <div class="plates-collection">
    {projects.items.map((project, index) => {
      const projectImage = resolveProjectImage(project.image);
      const roman = romanNumerals[index] || String(index + 1);

      return (
        <article class="plate-entry reveal" style={`--reveal-delay: ${index * 60}ms;`}>
          <div class="plate-header">
            <span class="plate-tag">Plate {roman}</span>
            <span class="plate-category">{project.category}</span>
          </div>

          <div class="plate-body">
            <div class="plate-prose">
              <h3 class="plate-title">{project.name}</h3>

              <p class="plate-desc">{project.description}</p>

              <div class="plate-stack">
                <span class="stack-label">Technologies:</span>
                <span class="stack-items">
                  {project.technologies.join(" · ")}
                </span>
              </div>

              <div class="plate-links">
                {project.liveDemo && (
                  <a
                    href={project.liveDemo}
                    target="_blank"
                    rel="noreferrer"
                    class="plate-link plate-link--primary"
                  >
                    <span>Live Demonstration</span>
                    <span class="arrow-glyph" aria-hidden="true">↗</span>
                  </a>
                )}
                <a
                  href={project.sourceCode}
                  target="_blank"
                  rel="noreferrer"
                  class="plate-link"
                >
                  <AstroIcon name="simple-icons:github" class="source-icon" />
                  <span>Source Code</span>
                  <span class="arrow-glyph" aria-hidden="true">↗</span>
                </a>
              </div>
            </div>

            {projectImage && (
              <div class="plate-visual">
                <div class="visual-canvas">
                  <Image
                    src={projectImage}
                    alt={`${project.name} plate`}
                    class="visual-img"
                    loading="lazy"
                  />
                </div>
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .plates-collection {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .plate-entry {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: 4.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .plate-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .plate-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .plate-tag {
    color: var(--accent);
    font-weight: 600;
  }

  .plate-category {
    color: var(--ink-faint);
  }

  .plate-body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.25fr);
    gap: 3rem;
    align-items: center;
  }

  .plate-prose {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .plate-title {
    font-family: var(--display);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.1;
  }

  .plate-desc {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--ink-soft);
    line-height: 1.7;
    word-break: break-word;
  }

  .plate-stack {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    background: var(--paper-surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .stack-items {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    line-height: 1.5;
    word-break: break-word;
  }

  .plate-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }

  .plate-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-soft);
    transition: color 160ms ease;
  }

  .plate-link:hover {
    color: var(--accent);
  }

  .plate-link--primary {
    color: var(--ink);
    font-weight: 600;
  }

  .plate-link--primary:hover {
    color: var(--accent);
  }

  .source-icon {
    width: 14px;
    height: 14px;
  }

  .arrow-glyph {
    font-size: 0.8125rem;
    color: var(--accent);
  }

  /* Plate Visual Canvas */
  .plate-visual {
    width: 100%;
  }

  .visual-canvas {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--hairline-accent);
    background: var(--paper-surface);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    aspect-ratio: 16 / 10;
  }

  .visual-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .visual-canvas:hover .visual-img {
    transform: scale(1.025);
  }

  @media (max-width: 860px) {
    .plate-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .plates-collection {
      gap: 3.5rem;
    }
  }
</style>
