---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

interface ProjectItem {
  id: string;
  name: string;
  category: string;
  description: string;
  technologies: string[];
  features: string[];
  liveDemo: string;
  sourceCode: string;
}

interface Props {
  projects: {
    title: string;
    subtitle: string;
    items: ProjectItem[];
  };
}

const { projects } = Astro.props;

const getTechIcon = (tech: string) => {
  const normalized = tech.toLowerCase();

  if (normalized.includes("react")) return { name: "react", color: "var(--icon-react)", tone: "rgba(34, 211, 238, 0.14)" };
  if (normalized.includes("typescript")) return { name: "typescript", color: "var(--icon-typescript)", tone: "rgba(96, 165, 250, 0.14)" };
  if (normalized.includes("next")) return { name: "nextjs", color: "var(--icon-nextjs)", tone: "rgba(255, 255, 255, 0.1)" };
  if (normalized.includes("node")) return { name: "nodejs", color: "var(--icon-nodejs)", tone: "rgba(132, 204, 22, 0.12)" };
  if (normalized.includes("express")) return { name: "code", color: "var(--icon-express)", tone: "rgba(209, 213, 219, 0.1)" };
  if (normalized.includes("nest")) return { name: "code", color: "var(--icon-nestjs)", tone: "rgba(239, 68, 68, 0.12)" };
  if (normalized.includes("mongo")) return { name: "database", color: "var(--icon-mongodb)", tone: "rgba(34, 197, 94, 0.12)" };
  if (normalized.includes("postgre")) return { name: "postgres", color: "var(--icon-postgres)", tone: "rgba(96, 165, 250, 0.12)" };
  if (normalized.includes("redis")) return { name: "redis", color: "var(--icon-redis)", tone: "rgba(239, 68, 68, 0.12)" };
  if (normalized.includes("docker")) return { name: "docker", color: "var(--icon-docker)", tone: "rgba(96, 165, 250, 0.14)" };
  if (normalized.includes("tailwind")) return { name: "tailwind", color: "var(--icon-tailwind)", tone: "rgba(34, 211, 238, 0.14)" };
  if (normalized.includes("aws")) return { name: "aws", color: "var(--icon-aws)", tone: "rgba(245, 158, 11, 0.12)" };
  if (normalized.includes("paypal")) return { name: "paypal", color: "var(--icon-paypal)", tone: "rgba(96, 165, 250, 0.14)" };
  if (normalized.includes("websocket") || normalized.includes("webrtc")) {
    return { name: "message", color: "var(--icon-message)", tone: "rgba(34, 197, 94, 0.12)" };
  }

  return { name: "generic-tech", color: "var(--icon-generic)", tone: "rgba(147, 197, 253, 0.12)" };
};
---

<section class="section" id="projects">
  <div class="reveal reveal--up">
    <SectionHeading icon="code" title={projects.title} subtitle={projects.subtitle} />
  </div>

  <div class="projects-list">
    {projects.items.map((project, index) => (
      <article class="project-card reveal reveal--up" style={`--reveal-delay: ${120 + index * 70}ms;`}>
        <div class="project-card__media">
          <div class="project-card__placeholder" aria-hidden="true">
            <span>{project.name.slice(0, 2).toUpperCase()}</span>
          </div>
        </div>

        <div class="project-card__body">
          <div class="project-card__header">
            <div>
              <p class="project-card__category">{project.category}</p>
              <h3>{project.name}</h3>
            </div>
            <div class="project-card__actions">
              <a href={project.liveDemo} target="_blank" rel="noreferrer">
                <Icon name="external" class="project-card__action-icon" />
                Live Demo
              </a>
              <a href={project.sourceCode} target="_blank" rel="noreferrer">
                <Icon name="github" class="project-card__action-icon" />
                GitHub
              </a>
            </div>
          </div>

          <p class="project-card__description">{project.description}</p>

          <div class="project-card__tech-grid">
            {project.technologies.map((tech) => {
              const icon = getTechIcon(tech);
              return (
                <div class="project-card__tech-tile" style={`--tech-color: ${icon.color}; --tech-tone: ${icon.tone};`}>
                  <span class="project-card__tech-icon-wrap">
                    <Icon name={icon.name} class="project-card__tech-icon" />
                  </span>
                  <span class="project-card__tech-label">{tech}</span>
                </div>
              );
            })}
          </div>

          <ul class="project-card__features">
            {project.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects-list {
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.92fr) minmax(0, 1.5fr);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(96, 165, 250, 0.2);
    background: #050505;
  }

  .project-card__media {
    min-height: 100%;
    background: #020202;
  }

  .project-card__placeholder {
    height: 100%;
    min-height: 260px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at top left, rgba(96, 165, 250, 0.16), transparent 36%),
      linear-gradient(145deg, rgba(8, 8, 8, 1), rgba(2, 2, 2, 1));
  }

  .project-card__placeholder span {
    width: 5.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .project-card__body {
    padding: 1.5rem;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .project-card__category,
  .project-card__description {
    margin: 0;
  }

  .project-card__category {
    color: #8ebeff;
    margin-bottom: 0.35rem;
    font-size: 0.92rem;
  }

  .project-card__header h3 {
    margin: 0;
    font-size: 1.45rem;
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .project-card__actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #9bc7ff;
    font-size: 0.92rem;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(96, 165, 250, 0.18);
    background: rgba(255, 255, 255, 0.02);
  }

  .project-card__action-icon {
    width: 1rem;
    height: 1rem;
  }

  .project-card__description {
    color: #d3dce8;
    line-height: 1.75;
  }

  .project-card__tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0 1.1rem;
  }

  .project-card__tech-tile {
    width: 6rem;
    min-height: 6.1rem;
    padding: 0.75rem 0.55rem 0.65rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0.01)),
      var(--tech-tone);
    text-align: center;
  }

  .project-card__tech-icon-wrap {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    color: var(--tech-color);
  }

  .project-card__tech-icon {
    width: 2rem;
    height: 2rem;
  }

  .project-card__tech-label {
    color: #dce7f3;
    font-size: 0.78rem;
    line-height: 1.2;
  }

  .project-card__features {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.55rem;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }
</style>
