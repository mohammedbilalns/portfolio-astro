---
import { Icon as AstroIcon } from "astro-icon/components";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface ProjectItem {
  id: string;
  name: string;
  category: string;
  description: string;
  technologies: string[];
  features: string[];
  liveDemo?: string;
  sourceCode: string;
  image?: string;
  status?: "ongoing" | "completed";
}

interface Props {
  projects: {
    title: string;
    subtitle: string;
    items: ProjectItem[];
  };
}

const { projects } = Astro.props;

// Import all project images eagerly
const projectImages = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp,avif,gif,svg,tiff}', { eager: true });
const techImages = import.meta.glob<{ default: ImageMetadata }>('../assets/tech/*.{png,jpg,jpeg,webp,avif,gif,svg,tiff}', { eager: true });

const techImageByKey = {
  bullmq: techImages["../assets/tech/bullmq.png"]?.default,
  drizzle: techImages["../assets/tech/drizzle.png"]?.default,
  langchain: techImages["../assets/tech/langchain.png"]?.default,
  razorpay: techImages["../assets/tech/razorpay.png"]?.default,
  tanstack: techImages["../assets/tech/tanstack.png"]?.default,
  tesseract: techImages["../assets/tech/tesseract.png"]?.default,
  tmdb: techImages["../assets/tech/tmdb.png"]?.default,
  webrtc: techImages["../assets/tech/webrtc.png"]?.default,
  zod: techImages["../assets/tech/zod.webp"]?.default,
};

const techIconRules = [
  { match: "react", icon: { name: "skill-icons:react-dark", color: "#61DAFB" } },
  { match: "typescript", icon: { name: "skill-icons:typescript", color: "#3178C6" } },
  { match: "next", icon: { name: "skill-icons:nextjs-dark", color: "#FFFFFF" } },
  { match: "node", icon: { name: "skill-icons:nodejs-dark", color: "#66CC22" } },
  { match: "express", icon: { name: "skill-icons:expressjs-dark", color: "#000000" } },
  { match: "nest", icon: { name: "skill-icons:nestjs-dark", color: "#E0234E" } },
  { match: "fastify", icon: { name: "solar:stars-bold-duotone", color: "#000000" } },
  { match: "langchain", image: techImageByKey.langchain },
  { match: "zod", image: techImageByKey.zod },
  { match: "tmdb", image: techImageByKey.tmdb },
  { match: "mongo", icon: { name: "skill-icons:mongodb", color: "#47B363" } },
  { match: "postgre", icon: { name: "skill-icons:postgresql-dark", color: "#336798" } },
  { match: "redis", icon: { name: "skill-icons:redis-dark", color: "#DC382B" } },
  { match: "docker", icon: { name: "skill-icons:docker", color: "#007BD1" } },
  { match: "tailwind", icon: { name: "skill-icons:tailwindcss-dark", color: "#06B6D4" } },
  { match: "aws", icon: { name: "skill-icons:aws-dark", color: "#FF9900" } },
  { match: "paypal", icon: { name: "logos:paypal", color: "#0071C5" } },
  { match: "bullmq", image: techImageByKey.bullmq },
  { match: "razorpay", image: techImageByKey.razorpay },
  { match: "websocket", icon: { name: "tabler:brand-socket-io", color: "#01A84C" } },
  { match: "webrtc", image: techImageByKey.webrtc },
  { match: "drizzle", image: techImageByKey.drizzle },
  { match: "tanstack", image: techImageByKey.tanstack },
  { match: "ejs", icon: { name: "simple-icons:ejs", color: "#ADADAD" } },
  { match: "mvc", icon: { name: "carbon:workflow-automation", color: "#93C5FD" } },
  { match: "tesseract", image: techImageByKey.tesseract },
  { match: "go", icon: { name: "skill-icons:golang", color: "#00ADD8" } },
  { match: "bubble", icon: { name: "carbon:terminal", color: "#FF6B6B" } },
  { match: "tui", icon: { name: "carbon:terminal", color: "#FF6B6B" } },
  { match: "terminal", icon: { name: "carbon:terminal", color: "#FF6B6B" } },
  { match: "torrent", icon: { name: "simple-icons:bittorrent", color: "#22C55E" } },
  { match: "magnet", icon: { name: "ph:magnet-bold", color: "#22C55E" } },
  { match: "bittorrent", icon: { name: "simple-icons:bittorrent", color: "#22C55E" } },
  { match: "toml", icon: { name: "simple-icons:toml", color: "#9C4128" } },
  { match: "sqlite", icon: { name: "skill-icons:sqlite", color: "#0F80CC" } },
  { match: "whatsapp", icon: { name: "logos:whatsapp-icon", color: "#25D366" } },
  { match: "baileys", icon: { name: "tabler:brand-socket-io", color: "#01A84C" } },
  { match: "image processing", icon: { name: "solar:stars-bold-duotone", color: "#A855F7" } },
  { match: "rest", icon: { name: "solar:stars-bold-duotone", color: "#38BDF8" } },
];

const resolveTechAsset = (tech: string) => {
  const normalized = tech.toLowerCase();
  const match = techIconRules.find((rule) => normalized.includes(rule.match));

  if (match?.image) {
    return { type: "image" as const, src: match.image };
  }

  if (match?.icon) {
    return { type: "icon" as const, ...match.icon };
  }

  return { type: "icon" as const, name: "solar:stars-bold-duotone", color: "#93C5FD" };
};

const resolveProjectImage = (image?: string) => {
  if (!image) return null;
  const key = `../assets/projects/${image}`;
  return projectImages[key]?.default ?? null;
};
---

<section class="section" id="projects">
  <div class="reveal reveal--up">
    <SectionHeading icon="code" title={projects.title} subtitle={projects.subtitle} />
  </div>

  <div class="projects-list">
    {projects.items.map((project, index) => {
      const projectImage = resolveProjectImage(project.image);

      return (
        <article class="project-card reveal reveal--up" style={`--reveal-delay: ${120 + index * 70}ms;`}>
          <div class="project-card__media">
            {projectImage ? (
              <Image
                src={projectImage}
                alt={project.name}
                class="project-card__image"
                loading={index === 0 ? "eager" : "lazy"}
                widths={[480, 720, 960]}
                sizes="(max-width: 820px) 100vw, 40vw"
                format="webp"
              />
            ) : (
              <div class="project-card__placeholder" aria-hidden="true">
                <span>{project.name.slice(0, 2).toUpperCase()}</span>
              </div>
            )}
          </div>

          <div class="project-card__body">
            <div class="project-card__header">
              <div>
                <p class="project-card__category">{project.category}</p>
                <div class="project-card__title-row">
                  <h3>{project.name}</h3>
                  {project.status === "ongoing" && (
                    <span class="project-card__status" title="Actively in development">
                      <span class="project-card__status-dot" aria-hidden="true" />
                      Ongoing
                    </span>
                  )}
                  <div class="project-card__tech-icons">
                    {project.technologies.map((tech) => {
                      const asset = resolveTechAsset(tech);
                      return asset.type === "image" ? (
                        <Image
                          src={asset.src}
                          alt={tech}
                          class="project-card__tech-icon project-card__tech-icon--image"
                          loading="lazy"
                          widths={[24, 48]}
                          sizes="24px"
                          format="webp"
                        />
                      ) : (
                        <AstroIcon name={asset.name} class="project-card__tech-icon" title={tech} style={`color: ${asset.color}`} />
                      );
                    })}
                  </div>
                </div>
              </div>
              <div class="project-card__actions">
                {project.liveDemo && (
                  <a href={project.liveDemo} target="_blank" rel="noreferrer">
                    Live Demo
                  </a>
                )}
                <a href={project.sourceCode} target="_blank" rel="noreferrer">
                  <Icon name="github" class="project-card__action-icon" />
                  GitHub
                </a>
              </div>
            </div>

            <p class="project-card__description">{project.description}</p>

            <details class="project-card__features-wrap" open>
              <summary class="project-card__features-toggle">Key features</summary>
              <ul class="project-card__features">
                {project.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </details>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .projects-list {
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.92fr) minmax(0, 1.5fr);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(96, 165, 250, 0.2);
    background: #050505;
  }

  .project-card__media {
    min-height: 100%;
    background: #020202;
  }

  .project-card__placeholder {
    height: 100%;
    min-height: 260px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at top left, rgba(96, 165, 250, 0.16), transparent 36%),
      linear-gradient(145deg, rgba(8, 8, 8, 1), rgba(2, 2, 2, 1));
  }

  .project-card__placeholder span {
    width: 5.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .project-card__body {
    padding: 1.5rem;
    min-width: 0;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .project-card__header > div:first-child {
    min-width: 0;
    flex: 1;
  }

  .project-card__category,
  .project-card__description {
    margin: 0;
  }

  .project-card__category {
    color: #8ebeff;
    margin-bottom: 0.35rem;
    font-size: 0.92rem;
  }

  .project-card__header h3 {
    margin: 0;
    font-size: 1.45rem;
    overflow-wrap: anywhere;
  }

  .project-card__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .project-card__actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #4ade80;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0;
    border: none;
    background: none;
    transition: color 160ms ease;
  }

  .project-card__actions a:hover {
    color: #22c55e;
    text-decoration: underline;
  }

  .project-card__action-icon {
    width: 1rem;
    height: 1rem;
  }

  .project-card__description {
    color: #d3dce8;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .project-card__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .project-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.35);
    background: rgba(251, 191, 36, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .project-card__status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #fbbf24;
    animation: status-pulse 1.6s ease-in-out infinite;
  }

  @keyframes status-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.8); }
  }

  .project-card__tech-icons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project-card__tech-icon {
    width: 1.45rem;
    height: 1.45rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .project-card__tech-icon--image {
    border-radius: 0.3rem;
  }

  .project-card__features {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.55rem;
    line-height: 1.6;
  }

  .project-card__features-toggle {
    display: none;
  }

  @media (max-width: 640px) {
    .project-card__features-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      margin-top: 1rem;
      color: #8ebeff;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }

    .project-card__features-toggle::-webkit-details-marker {
      display: none;
    }

    .project-card__features-toggle::after {
      content: "+";
      display: inline-grid;
      place-items: center;
      width: 1.15rem;
      height: 1.15rem;
      border-radius: 999px;
      border: 1px solid rgba(96, 165, 250, 0.35);
      font-size: 0.85rem;
      line-height: 1;
    }

    .project-card__features-wrap[open] > .project-card__features-toggle::after {
      content: "−";
    }

    .project-card__features-wrap:not([open]) > .project-card__features {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .project-card__body {
      padding: 1.2rem;
    }

    .project-card__header {
      flex-direction: column;
    }

    .project-card__actions {
      justify-content: flex-start;
      gap: 1rem;
    }

    .project-card__header h3 {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  if (window.matchMedia("(max-width: 640px)").matches) {
    document
      .querySelectorAll(".project-card__features-wrap[open]")
      .forEach((element) => element.removeAttribute("open"));
  }
</script>
