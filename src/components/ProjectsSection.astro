---
import { Icon as AstroIcon } from "astro-icon/components";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

interface ProjectItem {
  id: string;
  name: string;
  category: string;
  description: string;
  technologies: string[];
  features: string[];
  liveDemo: string;
  sourceCode: string;
  image?: string;
}

interface Props {
  projects: {
    title: string;
    subtitle: string;
    items: ProjectItem[];
  };
}

const { projects } = Astro.props;


const getTechIcon = (tech: string) => {
  const normalized = tech.toLowerCase();

  if (normalized.includes("react")) return { name: "skill-icons:react-dark", tone: "rgba(34, 211, 238, 0.14)", color: "#61DAFB" };
  if (normalized.includes("typescript")) return { name: "skill-icons:typescript", tone: "rgba(96, 165, 250, 0.14)", color: "#3178C6" };
  if (normalized.includes("next")) return { name: "skill-icons:nextjs-dark", tone: "rgba(255, 255, 255, 0.1)", color: "#FFFFFF" };
  if (normalized.includes("node")) return { name: "skill-icons:nodejs-dark", tone: "rgba(132, 204, 22, 0.12)", color: "#66CC22" };
  if (normalized.includes("express")) return { name: "skill-icons:expressjs-dark", tone: "rgba(209, 213, 219, 0.1)", color: "#000000" };
  if (normalized.includes("nest")) return { name: "skill-icons:nestjs-dark", tone: "rgba(239, 68, 68, 0.12)", color: "#E0234E" };
  if (normalized.includes("fastify")) return { name: "solar:stars-bold-duotone", tone: "rgba(0, 0, 0, 0.12)", color: "#000000" };
  if (normalized.includes("langchain")) return { name: "solar:stars-bold-duotone", tone: "rgba(27, 197, 110, 0.12)", color: "#1BC56E" };
  if (normalized.includes("zod")) return { name: "solar:stars-bold-duotone", tone: "rgba(61, 162, 249, 0.12)", color: "#3DA2F9" };
  if (normalized.includes("tmdb")) return { name: "solar:stars-bold-duotone", tone: "rgba(1, 182, 139, 0.12)", color: "#01B68B" };
  if (normalized.includes("mongo")) return { name: "skill-icons:mongodb", tone: "rgba(34, 197, 94, 0.12)", color: "#47B363" };
  if (normalized.includes("postgre")) return { name: "skill-icons:postgresql-dark", tone: "rgba(96, 165, 250, 0.12)", color: "#336798" };
  if (normalized.includes("redis")) return { name: "skill-icons:redis-dark", tone: "rgba(239, 68, 68, 0.12)", color: "#DC382B" };
  if (normalized.includes("docker")) return { name: "skill-icons:docker", tone: "rgba(96, 165, 250, 0.14)", color: "#007BD1" };
  if (normalized.includes("tailwind")) return { name: "skill-icons:tailwindcss-dark", tone: "rgba(34, 211, 238, 0.14)", color: "#06B6D4" };
  if (normalized.includes("aws")) return { name: "skill-icons:aws-dark", tone: "rgba(245, 158, 11, 0.12)", color: "#FF9900" };
  if (normalized.includes("paypal")) return { name: "logos:paypal", tone: "rgba(0, 113, 197, 0.14)", color: "#0071C5" };
  if (normalized.includes("bullmq")) return { name: "carbon:message-queue", tone: "rgba(251, 191, 36, 0.12)", color: "#FF5900" };
  if (normalized.includes("websocket")) return { name: "tabler:brand-socket-io", tone: "rgba(1, 168, 76, 0.12)", color: "#01A84C" };
  if (normalized.includes("webrtc")) return { name: "mdi:video-wireless-outline", tone: "rgba(51, 102, 204, 0.12)", color: "#3366CC" };
  if (normalized.includes("drizzle")) return { name: "simple-icons:drizzle", tone: "rgba(195, 52, 255, 0.12)", color: "#C334FF" };
  if (normalized.includes("ejs")) return { name: "simple-icons:ejs", tone: "rgba(173, 173, 173, 0.12)", color: "#ADADAD" };
  if (normalized.includes("mvc")) return { name: "carbon:workflow-automation", tone: "rgba(147, 197, 253, 0.12)", color: "#93C5FD" };
  if (normalized.includes("tesseract")) return { name: "mdi:text-recognition", tone: "rgba(244, 114, 182, 0.12)", color: "#F472B6" };
  if (normalized.includes("image processing")) return { name: "solar:stars-bold-duotone", tone: "rgba(168, 85, 247, 0.12)", color: "#A855F7" };
  if (normalized.includes("rest")) return { name: "solar:stars-bold-duotone", tone: "rgba(56, 189, 248, 0.12)", color: "#38BDF8" };

  return { name: "solar:stars-bold-duotone", tone: "rgba(147, 197, 253, 0.12)", color: "#93C5FD" };
};
---

<section class="section" id="projects">
  <div class="reveal reveal--up">
    <SectionHeading icon="code" title={projects.title} subtitle={projects.subtitle} />
  </div>

  <div class="projects-list">
    {projects.items.map((project, index) => (
      <article class="project-card reveal reveal--up" style={`--reveal-delay: ${120 + index * 70}ms;`}>
        <div class="project-card__media">
          {project.image ? (
            <img src={project.image} alt={project.name} class="project-card__image" loading="lazy" />
          ) : (
            <div class="project-card__placeholder" aria-hidden="true">
              <span>{project.name.slice(0, 2).toUpperCase()}</span>
            </div>
          )}
        </div>

        <div class="project-card__body">
          <div class="project-card__header">
            <div>
              <p class="project-card__category">{project.category}</p>
              <div class="project-card__title-row">
                <h3>{project.name}</h3>
                <div class="project-card__tech-icons">
                  {project.technologies.map((tech) => {
                    const icon = getTechIcon(tech);
                    return (
                      <AstroIcon name={icon.name} class="project-card__tech-icon" title={tech} style={`color: ${icon.color || 'var(--icon-color)'}`} />
                    );
                  })}
                </div>
              </div>
            </div>
            <div class="project-card__actions">
              <a href={project.liveDemo} target="_blank" rel="noreferrer">
                Live Demo
              </a>
              <a href={project.sourceCode} target="_blank" rel="noreferrer">
                <Icon name="github" class="project-card__action-icon" />
                GitHub
              </a>
            </div>
          </div>

          <p class="project-card__description">{project.description}</p>

          <ul class="project-card__features">
            {project.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects-list {
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.92fr) minmax(0, 1.5fr);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(96, 165, 250, 0.2);
    background: #050505;
  }

  .project-card__media {
    min-height: 100%;
    background: #020202;
  }

  .project-card__placeholder {
    height: 100%;
    min-height: 260px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at top left, rgba(96, 165, 250, 0.16), transparent 36%),
      linear-gradient(145deg, rgba(8, 8, 8, 1), rgba(2, 2, 2, 1));
  }

  .project-card__placeholder span {
    width: 5.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.05);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .project-card__body {
    padding: 1.5rem;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .project-card__category,
  .project-card__description {
    margin: 0;
  }

  .project-card__category {
    color: #8ebeff;
    margin-bottom: 0.35rem;
    font-size: 0.92rem;
  }

  .project-card__header h3 {
    margin: 0;
    font-size: 1.45rem;
  }

  .project-card__actions {
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  .project-card__actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #4ade80;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0;
    border: none;
    background: none;
    transition: color 160ms ease;
  }

  .project-card__actions a:hover {
    color: #22c55e;
    text-decoration: underline;
  }

  .project-card__action-icon {
    width: 1rem;
    height: 1rem;
  }

  .project-card__description {
    color: #d3dce8;
    line-height: 1.75;
  }

  .project-card__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .project-card__tech-icons {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .project-card__tech-icon {
    width: 1.45rem;
    height: 1.45rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .project-card__features {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.55rem;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }
</style>
