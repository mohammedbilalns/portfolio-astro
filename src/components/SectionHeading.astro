---
interface Props {
  icon: string;
  title: string;
  subtitle?: string;
}

const { icon, title, subtitle } = Astro.props;
---

<div class="section__heading">
  <div class="section__eyebrow">
    <span class="section__icon" aria-hidden="true">{icon}</span>
    <h2 class="section__title">{title}</h2>
  </div>
  {subtitle && <p class="section__subtitle">{subtitle}</p>}
  <div class="section__line" aria-hidden="true"></div>
</div>
