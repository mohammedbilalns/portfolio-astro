---
interface Props {
  tag?: string;
  title: string;
  subtitle?: string;
}

const { tag, title, subtitle } = Astro.props;
---

<header class="section-head reveal">
  {tag && <p class="section-kicker">{tag}</p>}
  <h2 class="section-heading-title" set:html={title} />
  {subtitle && <p class="section-subtitle">{subtitle}</p>}
</header>
