---
import SectionHeading from "./SectionHeading.astro";

interface TechArsenalItem {
  name: string;
  icon: string;
  color: string;
}

interface Props {
  techArsenal: {
    title: string;
    subtitle: string;
    items: TechArsenalItem[];
  };
}

const { techArsenal } = Astro.props;

const disciplines = [
  {
    title: "Languages & Runtimes",
    technologies: "TypeScript · JavaScript · Go · Python · Node.js"
  },
  {
    title: "Backend Architecture & Systems",
    technologies: "Express.js · NestJS · Fastify · BullMQ · RESTful APIs"
  },
  {
    title: "Databases, Caching & Persistence",
    technologies: "PostgreSQL · MongoDB · Redis · SQLite"
  },
  {
    title: "Real-Time Protocols & Media",
    technologies: "WebRTC · WebSockets · Socket.io"
  },
  {
    title: "Frontend Engineering & State",
    technologies: "React.js · Next.js · TanStack Start · TanStack Query · Redux Toolkit · Zustand · Tailwind CSS"
  },
  {
    title: "Cloud, Infrastructure & Tooling",
    technologies: "Docker · AWS EC2 · Linux Systems · Nginx · GitHub Actions · Git · Grafana · Loki"
  }
];
---

<section class="section" id="skills">
  <header class="section-head reveal">
    <p class="section-kicker">Technical Repertoire</p>
    <h2 class="section-heading-title">Engineering <em>Disciplines</em></h2>
    <p class="section-subtitle">{techArsenal.subtitle}</p>
  </header>

  <div class="disciplines-table reveal" style="--reveal-delay: 80ms;">
    {disciplines.map((d, index) => (
      <div class="discipline-entry">
        <div class="discipline-col-title">
          <span class="discipline-index">0{index + 1}</span>
          <h3 class="discipline-name">{d.title}</h3>
        </div>
        <div class="discipline-col-techs">
          <div class="techs-list">{d.technologies}</div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .disciplines-table {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hairline);
  }

  .discipline-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: 2rem;
    padding: 1.75rem 0;
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    transition: background-color 160ms ease;
  }

  .discipline-col-title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .discipline-index {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .discipline-name {
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .discipline-col-techs {
    display: flex;
    align-items: center;
  }

  .techs-list {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink-soft);
    line-height: 1.7;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .discipline-entry {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding: 1.25rem 0;
      align-items: flex-start;
    }
  }
</style>
