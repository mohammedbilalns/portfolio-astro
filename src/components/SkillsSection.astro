---
import { Icon as AstroIcon } from "astro-icon/components";
import SectionHeading from "./SectionHeading.astro";

interface TechArsenalItem {
  name: string;
  icon: string;
  color: string;
}

interface Props {
  techArsenal: {
    title: string;
    subtitle: string;
    items: TechArsenalItem[];
  };
}

const { techArsenal } = Astro.props;

// Tailwind palette names stored in data mapped to hex (no Tailwind dependency).
const colorMap: Record<string, string> = {
  "text-blue-400": "#60a5fa",
  "text-yellow-400": "#facc15",
  "text-blue-500": "#3b82f6",
  "text-cyan-400": "#22d3ee",
  "text-green-400": "#4ade80",
  "text-gray-400": "#9ca3af",
  "text-red-500": "#ef4444",
  "text-red-400": "#f87171",
  "text-purple-500": "#a855f7",
  "text-orange-500": "#f97316",
  "text-orange-400": "#fb923c",
  "text-gray-300": "#d1d5db",
  "text-purple-400": "#c084fc",
  "text-black": "#e5e7eb",
};

const resolveColor = (name: string) => colorMap[name] ?? "#93c5fd";
---

<section class="section" id="skills">
  <div class="reveal reveal--up">
    <SectionHeading icon="cpu-chip" title={techArsenal.title} subtitle={techArsenal.subtitle} />
  </div>

  <div class="tech-arsenal-grid">
    {techArsenal.items.map((item, index) => (
      <article class="tech-card reveal reveal--up" style={`--reveal-delay: ${index * 30}ms;`}>
        <div class="tech-card__icon" style={`--icon-color: ${resolveColor(item.color)};`}>
          <AstroIcon name={item.icon} class="tech-card__icon-svg" />
        </div>
        <span class="tech-card__name">{item.name}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .tech-arsenal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1rem;
  }

  .tech-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.25rem 1rem;
    border-radius: var(--radius);
    border: 1px solid rgba(96, 165, 250, 0.2);
    background: linear-gradient(180deg, rgba(12, 18, 28, 0.72), rgba(12, 12, 12, 0.9));
    transition: all 0.3s ease;
    text-align: center;
  }

  .tech-card:hover {
    border-color: rgba(96, 165, 250, 0.5);
    background: linear-gradient(180deg, rgba(12, 18, 28, 0.9), rgba(12, 12, 12, 1));
    transform: translateY(-2px) scale(1.02);
  }

  .tech-card__icon {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, rgba(96, 165, 250, 0.15), rgba(12, 18, 28, 0.5));
    border: 1px solid var(--icon-color);
    transition: all 0.3s ease;
  }

  .tech-card:hover .tech-card__icon {
    transform: scale(1.1);
    border-color: var(--icon-color);
    box-shadow: 0 0 20px var(--icon-color);
  }

  .tech-card__icon-svg {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--icon-color);
    flex: 0 0 auto;
  }

  .tech-card__name {
    font-size: 0.85rem;
    font-weight: 500;
    color: #d8e1ea;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  @media (max-width: 640px) {
    .tech-arsenal-grid {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 0.75rem;
    }

    .tech-card {
      padding: 1rem 0.75rem;
    }

    .tech-card__icon {
      width: 2.5rem;
      height: 2.5rem;
    }

    .tech-card__icon-svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }
</style>
