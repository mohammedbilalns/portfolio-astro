---
import SectionHeading from "./SectionHeading.astro";

interface SkillCategory {
  name: string;
  items: string[];
}

interface Props {
  skills: {
    title: string;
    subtitle: string;
    categories: SkillCategory[];
  };
}

const { skills } = Astro.props;
---

<section class="section" id="skills">
  <div class="reveal reveal--up">
    <SectionHeading icon="stack" title={skills.title} subtitle={skills.subtitle} />
  </div>

  <div class="skills-grid">
    {skills.categories.map((category, index) => (
      <article class="skill-card reveal reveal--up" style={`--reveal-delay: ${120 + index * 60}ms;`}>
        <h3>{category.name}</h3>
        <div class="skill-pills">
          {category.items.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .skill-card {
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid rgba(96, 165, 250, 0.2);
    background: linear-gradient(180deg, rgba(12, 18, 28, 0.72), rgba(12, 12, 12, 0.9));
  }

  .skill-card h3 {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .skill-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .skill-pills span {
    display: inline-flex;
    align-items: center;
    min-height: 2.3rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: #d8e1ea;
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
