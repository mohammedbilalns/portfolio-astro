---
import SectionHeading from "./SectionHeading.astro";

interface TechArsenalItem {
  name: string;
  icon: string;
  color: string;
}

interface Props {
  techArsenal: {
    title: string;
    subtitle: string;
    items: TechArsenalItem[];
  };
}

const { techArsenal } = Astro.props;

const disciplines = [
  {
    title: "Languages & Runtimes",
    technologies: "TypeScript · JavaScript · Go · Python · Node.js",
    focus: "Type-safe engineering, concurrent services, and modular application logic."
  },
  {
    title: "Backend Architecture & Systems",
    technologies: "Express.js · NestJS · Fastify · BullMQ · RESTful APIs",
    focus: "Clean Architecture, asynchronous job queues, and robust distributed services."
  },
  {
    title: "Databases, Caching & Persistence",
    technologies: "PostgreSQL · MongoDB · Redis · SQLite",
    focus: "Relational data modeling, high-speed key-value caching, and transactional integrity."
  },
  {
    title: "Real-Time Protocols & Media",
    technologies: "WebRTC · WebSockets · Socket.io",
    focus: "Low-latency peer-to-peer audio/video streaming and live bidirectional event dispatching."
  },
  {
    title: "Frontend Engineering & State",
    technologies: "React.js · Next.js · TanStack Start · TanStack Query · Redux Toolkit · Zustand · Tailwind CSS",
    focus: "High-performance reactive interfaces, optimistic mutations, and resilient state machines."
  },
  {
    title: "Cloud, Infrastructure & Tooling",
    technologies: "Docker · AWS EC2 · Linux Systems · Nginx · GitHub Actions · Git · Grafana · Loki",
    focus: "Containerized deployments, VPS orchestration, CI/CD pipelines, and observability."
  }
];
---

<section class="section" id="skills">
  <header class="section-head reveal">
    <p class="section-kicker">Technical Repertoire</p>
    <h2 class="section-heading-title">Engineering <em>Disciplines</em></h2>
    <p class="section-subtitle">{techArsenal.subtitle}</p>
  </header>

  <div class="disciplines-table reveal" style="--reveal-delay: 80ms;">
    {disciplines.map((d, index) => (
      <div class="discipline-entry">
        <div class="discipline-col-title">
          <span class="discipline-index">0{index + 1}</span>
          <h3 class="discipline-name">{d.title}</h3>
        </div>
        <div class="discipline-col-techs">
          <div class="techs-list">{d.technologies}</div>
          <p class="techs-focus">{d.focus}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .disciplines-table {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hairline);
  }

  .discipline-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--hairline);
    transition: background-color 160ms ease;
  }

  .discipline-col-title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .discipline-index {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .discipline-name {
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .discipline-col-techs {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .techs-list {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
    line-height: 1.6;
    letter-spacing: 0.02em;
  }

  .techs-focus {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .discipline-entry {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.5rem 0;
    }
  }
</style>
