---
import { Icon as AstroIcon } from "astro-icon/components";
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import bannerProfile from "../assets/banner-profile.png";

interface ContactDetails {
  email: string;
  location: string;
  github: string;
  linkedin: string;
  leetcode: string;
  availability: string;
}

interface HeroStat {
  value: string;
  label: string;
}

interface Props {
  hero: {
    greeting: string;
    name: string;
    title: string;
    description: string;
    primaryButton: { text: string; href: string };
    secondaryButton: { text: string; href: string };
  };
  about: {
    description: string;
    descriptionHtml?: string;
  };
  contact: ContactDetails;
  stats: HeroStat[];
}

const { hero, about, contact, stats } = Astro.props;

const socialLinks = [
  { label: "GitHub", href: contact.github, icon: "simple-icons:github", accent: "social-link--github" },
  { label: "LinkedIn", href: contact.linkedin, icon: "simple-icons:linkedin", accent: "social-link--linkedin" },
  { label: "LeetCode", href: contact.leetcode, icon: "simple-icons:leetcode", accent: "social-link--leetcode" },
];
---

<section class="hero section" id="home">
  <div class="hero__media reveal reveal--scale" style="--reveal-delay: 80ms;">
    <div class="hero__banner" aria-hidden="true">
      <Image src={bannerProfile} alt="Mohammed Bilal N S" class="hero__banner-img" />
    </div>
    <p class="hero__meta">
      <AstroIcon name="solar:map-point-bold-duotone" class="hero__meta-icon hero__meta-icon--location" />
      {contact.location}
    </p>
    <div class="hero__socials">
      {socialLinks.map((link, index) => (
        <a
          class={`social-link ${link.accent} reveal reveal--up`}
          style={`--reveal-delay: ${220 + index * 90}ms;`}
          href={link.href}
          target="_blank"
          rel="noreferrer"
          aria-label={link.label}
          title={link.label}
        >
          <AstroIcon name={link.icon} class="social-link__icon" />
        </a>
      ))}
    </div>
  </div>

  <div class="hero__content">
    <p class="hero__availability reveal reveal--up" style="--reveal-delay: 80ms;">
      <span class="hero__availability-dot" aria-hidden="true"></span>
      {contact.availability}
    </p>
    <p class="hero__greeting reveal reveal--up" style="--reveal-delay: 120ms;">{hero.greeting}</p>
    <h1 class="hero__title reveal reveal--up" style="--reveal-delay: 180ms;">{hero.name}</h1>
    <p class="hero__role reveal reveal--up" style="--reveal-delay: 240ms;">{hero.title}</p>
    <p class="hero__description reveal reveal--up" style="--reveal-delay: 320ms;">{hero.description}</p>

    <p class="hero__about reveal reveal--up" style="--reveal-delay: 380ms;">
      {about.descriptionHtml ? <Fragment set:html={about.descriptionHtml} /> : about.description}
    </p>

    <div class="hero__actions reveal reveal--up" style="--reveal-delay: 440ms;">
      <a class="button button--primary" href={hero.primaryButton.href}>{hero.primaryButton.text}</a>
      <a class="button button--secondary" href={hero.secondaryButton.href}>
        {hero.secondaryButton.text}
      </a>
    </div>

    <a class="hero__mail reveal reveal--up" style="--reveal-delay: 460ms;" href={`mailto:${contact.email}`}>
      <Icon name="mail" class="hero__mail-icon" />
      Work With Me
    </a>

    <div class="hero__stats reveal reveal--up" style="--reveal-delay: 520ms;">
      {stats.map((stat) => (
        <div class="hero__stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .hero__media {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
  }

  .hero__avatar {
    width: 10.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgba(96, 165, 250, 0.25);
    background:
      radial-gradient(circle at 30% 30%, rgba(96, 165, 250, 0.3), transparent 45%),
      linear-gradient(145deg, rgba(17, 24, 39, 0.95), rgba(10, 10, 10, 0.95));
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .hero__banner {
    width: 100%;
    max-width: 16rem;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(96, 165, 250, 0.25);
    background: linear-gradient(145deg, rgba(17, 24, 39, 0.95), rgba(10, 10, 10, 0.95));
  }

  .hero__banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__meta-icon,
  .hero__mail-icon {
    width: 1.2rem;
    height: 1.2rem;
  }

  .social-link__icon {
    width: 1.75rem;
    height: 1.75rem;
  }

  .hero__meta-icon--location {
    color: #a5b4fc;
  }

  .hero__socials {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #8ebeff;
    transition: transform 160ms ease, color 160ms ease;
  }

  .social-link:hover {
    transform: translateY(-2px);
  }

  .social-link--github {
    color: #cfe2ff;
  }
  .social-link--github:hover {
    color: #ffffff;
  }

  .social-link--linkedin {
    color: #0077b5;
  }
  .social-link--linkedin:hover {
    color: #37b7ff;
  }

  .social-link--leetcode {
    color: #ffa116;
  }
  .social-link--leetcode:hover {
    color: #ffc059;
  }

  .hero__greeting,
  .hero__role,
  .hero__description {
    margin: 0;
  }

  .hero__about :global(a) {
    color: #8ebeff;
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .hero__about :global(a:hover) {
    color: #cfe2ff;
  }

  .hero__greeting {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .hero__title {
    margin: 0 0 0.5rem;
    font-size: clamp(2.75rem, 7vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .hero__role {
    margin-bottom: 1rem;
    color: #b7c7dc;
    font-size: clamp(1.15rem, 3vw, 1.5rem);
  }

  .hero__description {
    max-width: 42rem;
    color: #cdd6e1;
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .hero__about {
    max-width: 42rem;
    color: #a8b8cc;
    line-height: 1.8;
    font-size: 1rem;
    margin: 1rem 0 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.75rem 0 1.3rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.1rem;
    border-radius: 12px;
    border: 1px solid transparent;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button--primary {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.85), rgba(29, 78, 216, 0.7));
    color: white;
  }

  .button--secondary {
    border-color: rgba(96, 165, 250, 0.3);
    background: rgba(15, 23, 42, 0.45);
    color: #d8e6ff;
  }

  .hero__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: #d8e6ff;
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 12px;
    padding: 0.8rem 1.5rem;
    background: rgba(10, 17, 31, 0.55);
    white-space: nowrap;
    width: max-content;
  }

  .hero__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(74, 222, 128, 0.3);
    background: rgba(74, 222, 128, 0.07);
    color: #86efac;
    font-size: 0.85rem;
    font-weight: 500;
    width: max-content;
    max-width: 100%;
  }

  .hero__availability-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: #4ade80;
    animation: availability-pulse 1.8s ease-in-out infinite;
  }

  @keyframes availability-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5); }
    50% { opacity: 0.7; box-shadow: 0 0 0 5px rgba(74, 222, 128, 0); }
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 1.75rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 5.5rem;
  }

  .hero__stat strong {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #e8f1ff;
    line-height: 1.2;
  }

  .hero__stat span {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__media {
      max-width: 320px;
      width: 100%;
      justify-self: center;
    }
  }
</style>
