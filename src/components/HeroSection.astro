---
interface ContactDetails {
  email: string;
  location: string;
  github: string;
  linkedin: string;
  leetcode: string;
}

interface Props {
  hero: {
    greeting: string;
    name: string;
    title: string;
    description: string;
    primaryButton: { text: string; href: string };
    secondaryButton: { text: string; href: string };
  };
  contact: ContactDetails;
}

const { hero, contact } = Astro.props;

const socialLinks = [
  { label: "GitHub", href: contact.github, accent: "social-link--orange" },
  { label: "LinkedIn", href: contact.linkedin, accent: "social-link--blue" },
  { label: "LeetCode", href: contact.leetcode, accent: "social-link--gold" },
];
---

<section class="hero section" id="home">
  <div class="hero__media panel">
    <div class="hero__avatar" aria-hidden="true">MB</div>
    <p class="hero__meta">{contact.location}</p>
    <div class="hero__socials">
      {socialLinks.map((link) => (
        <a class={`social-link ${link.accent}`} href={link.href} target="_blank" rel="noreferrer">
          {link.label}
        </a>
      ))}
    </div>
  </div>

  <div class="hero__content">
    <p class="hero__greeting">{hero.greeting}</p>
    <h1 class="hero__title">{hero.name}</h1>
    <p class="hero__role">{hero.title}</p>
    <p class="hero__description">{hero.description}</p>

    <div class="hero__actions">
      <a class="button button--primary" href={hero.primaryButton.href}>{hero.primaryButton.text}</a>
      <a class="button button--secondary" href={hero.secondaryButton.href}>
        {hero.secondaryButton.text}
      </a>
    </div>

    <a class="hero__mail" href={`mailto:${contact.email}`}>Work With Me</a>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }

  .hero__media {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .hero__avatar {
    width: 10.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgba(96, 165, 250, 0.25);
    background:
      radial-gradient(circle at 30% 30%, rgba(96, 165, 250, 0.3), transparent 45%),
      linear-gradient(145deg, rgba(17, 24, 39, 0.95), rgba(10, 10, 10, 0.95));
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .hero__meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .hero__socials {
    width: 100%;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .social-link {
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.55rem 0.85rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: transform 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .social-link:hover {
    transform: translateY(-1px);
    color: var(--text);
  }

  .social-link--orange:hover {
    border-color: rgba(249, 115, 22, 0.45);
  }

  .social-link--blue:hover {
    border-color: rgba(96, 165, 250, 0.45);
  }

  .social-link--gold:hover {
    border-color: rgba(250, 204, 21, 0.45);
  }

  .hero__greeting,
  .hero__role,
  .hero__description {
    margin: 0;
  }

  .hero__greeting {
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .hero__title {
    margin: 0 0 0.5rem;
    font-size: clamp(2.75rem, 7vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .hero__role {
    margin-bottom: 1rem;
    color: #b7c7dc;
    font-size: clamp(1.15rem, 3vw, 1.5rem);
  }

  .hero__description {
    max-width: 42rem;
    color: #cdd6e1;
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.75rem 0 1.3rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.75rem 1.1rem;
    border-radius: 12px;
    border: 1px solid transparent;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button--primary {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.85), rgba(29, 78, 216, 0.7));
    color: white;
  }

  .button--secondary {
    border-color: rgba(96, 165, 250, 0.3);
    background: rgba(15, 23, 42, 0.45);
    color: #d8e6ff;
  }

  .hero__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #d8e6ff;
    border: 1px solid rgba(96, 165, 250, 0.35);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    background: rgba(10, 17, 31, 0.55);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__media {
      max-width: 320px;
      width: 100%;
      justify-self: center;
    }
  }
</style>
