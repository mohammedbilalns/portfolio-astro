---
import { Icon as AstroIcon } from "astro-icon/components";
import { Image } from "astro:assets";
import bannerProfile from "../assets/banner-profile.png";

interface ContactDetails {
  email: string;
  location: string;
  github: string;
  linkedin: string;
  leetcode: string;
  availability: string;
}

interface Props {
  hero: {
    name: string;
    title: string;
    description: string;
    primaryButton: { text: string; href: string };
    secondaryButton: { text: string; href: string };
  };
  about: {
    description: string;
  };
  contact: ContactDetails;
}

const { hero, about, contact } = Astro.props;

const socialLinks = [
  { label: "GitHub", href: contact.github, icon: "simple-icons:github" },
  { label: "LinkedIn", href: contact.linkedin, icon: "simple-icons:linkedin" },
  { label: "LeetCode", href: contact.leetcode, icon: "simple-icons:leetcode" },
];
---

<section class="hero-edition" id="home">
  <div class="hero-grid">
    <div class="hero-narrative reveal">
      <p class="hero-kicker">Software Engineer &amp; Architect</p>

      <h1 class="hero-statement">
        Tinkerer at heart, relentless in <em>what I build.</em>
      </h1>

      <p class="hero-bio">
        {about.description}
      </p>

      <!-- Signature Disciplines Strip -->
      <div class="hero-disciplines">
        <div class="discipline-row">
          <span class="discipline-label">Core Architecture</span>
          <span class="discipline-val">TypeScript · Node.js · Go · React · NestJS · PostgreSQL</span>
        </div>
        <div class="discipline-row">
          <span class="discipline-label">Real-Time &amp; Scale</span>
          <span class="discipline-val">WebRTC · WebSockets · BullMQ · Redis · Docker · AWS</span>
        </div>
      </div>

      <!-- Action Row -->
      <div class="hero-actions-row">
        <a class="btn btn--accent" href="#projects">
          <span>View Selected Work</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
        <a class="btn btn--outline" href="/Mohammed_Bilal.pdf" target="_blank" rel="noopener noreferrer" download="Mohammed_Bilal.pdf">
          <span>Resume</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
        <a class="btn btn--outline" href="#contact">
          <span>Get in Touch</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Socials & Direct Contact -->
      <div class="hero-footprint">
        <a href={`mailto:${contact.email}`} class="footprint-email">
          <span>{contact.email}</span>
        </a>

        <div class="footprint-divider" aria-hidden="true">•</div>

        <div class="footprint-socials">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="footprint-link"
              aria-label={link.label}
            >
              <AstroIcon name={link.icon} class="footprint-icon" />
              <span>{link.label}</span>
              <span class="footprint-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Portrait Area with Delicate Azure Framing -->
    <div class="hero-portrait-col reveal" style="--reveal-delay: 120ms;">
      <div class="portrait-capsule">
        <div class="portrait-frame">
          <Image
            src={bannerProfile}
            alt="Mohammed Bilal N S"
            class="portrait-img"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="portrait-caption">
          <span class="caption-name">{hero.name}</span>
          <span class="caption-loc">{contact.location}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-edition {
    padding: 3rem 0 5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.85fr);
    gap: 3.5rem;
    align-items: center;
  }

  .hero-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-kicker::before {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--accent);
  }

  .hero-statement {
    font-family: var(--display);
    font-size: clamp(2.6rem, 5.5vw, 4.2rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--ink);
    letter-spacing: -0.015em;
  }

  .hero-statement em {
    font-style: italic;
    font-family: var(--display);
    color: var(--accent);
  }

  .hero-bio {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 38rem;
  }

  .hero-disciplines {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.15rem 1.35rem;
    background: var(--paper-surface);
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-sm);
  }

  .discipline-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .discipline-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .discipline-val {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .hero-actions-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-arrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .hero-footprint {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-faint);
    padding-top: 0.5rem;
  }

  .footprint-email {
    color: var(--ink-soft);
    transition: color 160ms ease;
  }

  .footprint-email:hover {
    color: var(--accent);
  }

  .footprint-divider {
    color: var(--hairline-strong);
  }

  .footprint-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footprint-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-soft);
    transition: color 160ms ease;
  }

  .footprint-link:hover {
    color: var(--accent);
  }

  .footprint-icon {
    width: 14px;
    height: 14px;
  }

  .footprint-arrow {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /* Portrait Column */
  .hero-portrait-col {
    display: flex;
    justify-content: center;
  }

  .portrait-capsule {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 300px;
    width: 100%;
  }

  .portrait-frame {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--hairline-accent);
    background: var(--paper-surface);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    aspect-ratio: 4 / 5;
  }

  .portrait-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 35%, transparent 50%, rgba(8, 9, 13, 0.45) 100%),
      linear-gradient(180deg, rgba(56, 189, 248, 0.08) 0%, transparent 45%, rgba(8, 9, 13, 0.35) 100%);
    mix-blend-mode: soft-light;
    box-shadow: inset 0 0 24px rgba(8, 9, 13, 0.4);
    transition: opacity 400ms ease;
  }

  html[data-theme="light"] .portrait-frame::after {
    background:
      radial-gradient(ellipse at 50% 35%, transparent 50%, rgba(238, 234, 226, 0.4) 100%),
      linear-gradient(180deg, rgba(2, 132, 199, 0.06) 0%, transparent 45%, rgba(238, 234, 226, 0.3) 100%);
    mix-blend-mode: multiply;
    box-shadow: inset 0 0 24px rgba(238, 234, 226, 0.3);
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(88%) contrast(1.12) brightness(0.95);
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1), filter 450ms ease;
  }

  .portrait-frame:hover .portrait-img {
    filter: grayscale(45%) contrast(1.08) brightness(0.98);
    transform: scale(1.025);
  }

  .portrait-caption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.35rem 0.25rem 0;
    font-family: var(--font-mono);
  }

  .caption-name {
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .caption-loc {
    color: var(--ink-faint);
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-portrait-col {
      order: -1;
      justify-content: flex-start;
    }
    .portrait-capsule {
      max-width: 220px;
    }
  }
</style>
