---
import Header from "../components/Header.astro";
import "../styles/global.css";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  logo: string;
  navigation: NavItem[];
}

const { title, description, logo, navigation } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <Header logo={logo} name={title} navigation={navigation} />
      <slot />
    </div>
  </body>
</html>
