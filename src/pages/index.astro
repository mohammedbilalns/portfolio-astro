---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import profile from "../data/profile.json";
---

<Layout
  title={profile.site.title}
  description={profile.hero.description}
  logo={profile.site.logo}
  navigation={profile.site.navigation}
>
  <main class="page-main">
    <section class="section" id="home">
      <div class="panel placeholder-copy">
        Stage 1 foundation complete. The hero section will be implemented next using your profile
        data and the same visual structure as the `imabhishek` reference.
      </div>
    </section>

    <section class="section" id="about">
      <SectionHeading icon="01" title={profile.about.title} />
      <div class="panel placeholder-copy">
        Shared section scaffolding is in place for about, education, experience, skills, projects,
        and contact.
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>{profile.site.footer.copyright}</p>
  </footer>
</Layout>
