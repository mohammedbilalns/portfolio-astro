---
import AboutSection from "../components/AboutSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import HeroSection from "../components/HeroSection.astro";
import Layout from "../layouts/Layout.astro";
import SkillsSection from "../components/SkillsSection.astro";
import profile from "../data/profile.json";
---

<Layout
  title={profile.site.title}
  description={profile.hero.description}
  logo={profile.site.logo}
  navigation={profile.site.navigation}
>
  <main class="page-main">
    <HeroSection hero={profile.hero} contact={profile.contact.details} />
    <AboutSection about={profile.about} education={profile.education} />
    <ExperienceSection experience={profile.experience} />
    <SkillsSection skills={profile.skills} />
  </main>

  <footer class="site-footer">
    <p>{profile.site.footer.copyright}</p>
  </footer>
</Layout>
